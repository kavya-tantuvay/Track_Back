// Prisma schema for TrackBack.
// Uses the pgvector extension for CLIP embedding similarity search.
// The `embedding` column is an `Unsupported("vector(512)")` type — Prisma
// creates/manages the column but reads/writes to it happen via $queryRaw
// (see src/services/matching.ts and src/services/items.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum ItemType {
  lost
  found
}

enum ItemStatus {
  open
  resolved
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String // bcrypt hash
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String     @id @default(cuid())
  type        ItemType
  status      ItemStatus @default(open)
  title       String
  description String
  category    String
  location    String
  // Date the item was lost or found (not the post date).
  date        DateTime
  contact     String?
  imageUrl    String?

  // CLIP embedding (image + text blended, L2-normalized). Managed via raw SQL.
  embedding Unsupported("vector(512)")?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([category])
  @@index([ownerId])
}
