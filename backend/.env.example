# ---------------------------------------------------------------------------
# TrackBack backend configuration. Copy to `.env` and fill in.
# The app runs with just DATABASE_URL + JWT_SECRET; everything else is optional
# and enables "upgrades" (Cloudinary hosting, real CLIP) when provided.
#
# NOTE: when NODE_ENV=production, DATABASE_URL and JWT_SECRET have no defaults —
# the process refuses to start rather than run on a placeholder secret.
# ---------------------------------------------------------------------------

# Postgres connection string (must have the pgvector extension available).
# Local (docker compose up -d):
DATABASE_URL="postgresql://trackback:trackback@localhost:5432/trackback"
# Neon (production) — looks like:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/trackback?sslmode=require"

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT=4000
# Comma-separated list of allowed frontend origins (CORS).
# Use the exact deployed frontend origin in production; "*" reflects any origin.
CORS_ORIGIN="http://localhost:5173"

# ---- Cloudinary (optional, but recommended in production) ----
# If unset, uploaded images are saved to backend/uploads/ and served locally.
# Most PaaS filesystems are ephemeral, so local uploads disappear on redeploy.
# Grab this single value from your Cloudinary dashboard (Account Details).
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ---- CLIP / embeddings (optional tuning) ----
# Force the deterministic fallback embedder instead of downloading CLIP.
# Handy for fast local dev, offline work, CI, and small (<1 GB RAM) instances.
# EMBEDDER="fallback"
# Cache dir for transformers.js ONNX model files (downloaded once).
TRANSFORMERS_CACHE=".models"
# Blend weights for the match score (image vs text). Must sum to 1.0.
MATCH_IMAGE_WEIGHT=0.6
MATCH_TEXT_WEIGHT=0.4
# Extra score added when two items share the same category.
MATCH_CATEGORY_BONUS=0.05
# Default number of match suggestions returned.
MATCH_TOP_K=5
# ANN candidates pulled from the HNSW index per match query, as a multiple of
# top-K, before the category bonus is applied and the shortlist is re-ranked.
MATCH_CANDIDATE_MULTIPLIER=6
